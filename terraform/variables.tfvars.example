# AWS Incident Copilot - Example Terraform Variables
#
# Copy this file to terraform.tfvars and customize for your environment.
# NEVER commit terraform.tfvars with sensitive values to git.

aws_region  = "us-west-2"
environment = "dev"

# Cross-region inference profile (not a legacy foundation-model ID)
bedrock_model_id            = "us.anthropic.claude-sonnet-4-5-20250929-v1:0"
bedrock_foundation_model_id = "anthropic.claude-sonnet-4-5-20250929-v1:0"

# EKS clusters that receive access entries (View for investigation, Edit for remediation)
eks_cluster_names = [
  # "production-eks",
]
eks_remediation_namespaces = ["production"]

# ECS clusters the copilot is expected to investigate
ecs_cluster_names = [
  # "production-cluster",
]

# Optional: only set for cross-account assume-role. Leave unset in the same account.
# remediation_external_id = "replace-me-if-cross-account"

# SNS topic for Lambda error alarms (optional)
# alert_sns_topic_arn = "arn:aws:sns:us-west-2:123456789:incident-alerts"

# AgentCore is optional; the EventBridge -> Lambda path is always created.
# enable_agentcore            = false
# agentcore_enable_gateway    = false
# agentcore_enable_remediation = false
