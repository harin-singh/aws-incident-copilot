# Terraform state files
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Crash log files
crash.log
crash.*.log

# Terraform directory
.terraform/

# Variable files with sensitive data
*.tfvars
!*.tfvars.example

# Lock files (can be committed for reproducibility, but excluding by default)
.terraform.lock.hcl

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc
